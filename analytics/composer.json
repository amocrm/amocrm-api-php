{
    "name": "analytics/amocrm-analytics",
    "description": "Cross-channel analytics for amoCRM with Fusio integration",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "amocrm/amocrm-api-library": "^1.17",
        "fusio/fusio": "^4.0",
        "doctrine/dbal": "^3.0",
        "nesbot/carbon": "^2.72",
        "symfony/console": "^6.0",
        "symfony/dotenv": "^6.0",
        "monolog/monolog": "^3.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.0",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Analytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Analytics\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-html coverage",
        "style:check": "vendor/bin/phpcs",
        "style:fix": "vendor/bin/phpcbf",
        "analyse": "vendor/bin/phpstan analyse src --level=5",
        "migrate": "php bin/migrate"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
