# Application
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amocrm_analytics
DB_USER=postgres
DB_PASSWORD=

# amoCRM OAuth
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://your-domain.com/callback
AMOCRM_BASE_DOMAIN=youraccount.amocrm.ru

# Fusio
FUSIO_PUBLIC_URL=https://your-domain.com
FUSIO_APP_SECRET=

# Analytics
ANALYTICS_BATCH_SIZE=100
ANALYTICS_WEBHOOK_TIMEOUT=5
ANALYTICS_MAX_RETRIES=3

# Logging
LOG_PATH=var/log
LOG_LEVEL=info

# Token Storage
TOKEN_STORAGE_PATH=var/tokens
